flowchart TB
    repo[("Your repo<br/>or several repos")] --> map["1 · map-codebase<br/>inventory + whole-system map: services, data,<br/>APIs, auth, CI/CD, deployment, tests, risks<br/>(several repos: a system map of how they connect)"]
    map --> gate{{"check_ready: maps complete and current?<br/>focus valid? what's already decided?"}}
    gate --> plan["2 · hiring-plan<br/>asks follow-up questions,<br/>proposes 2–3 role designs"]
    need(["Your hiring need + focus<br/>e.g. own the payment library"]) --> plan
    plan --> profile["3 · repo-profile<br/>the role's area, in depth"]
    profile --> jdw["4 · write-job-description<br/>Q&A + repo → public job posting,<br/>checked for leaks and biased wording"]
    jdw --> post(["jd.md<br/>ready to publish"])
    profile --> rubric["5 · hiring-rubric<br/>weighted criteria with observable anchors"]
    post -. same must-haves .-> rubric
    rubric --> approve{{"You approve the rubric"}}
    approve --> screen["6 · screen-candidates<br/>redact, score each CV with quotes, validate, rank"]
    cvs[("CVs<br/>PDF · DOCX · MD")] --> screen
    screen --> report(["report.html + report.md<br/>shortlist, heatmap, strengths, gaps"])
    report --> kit["7 · interview-kit<br/>same core questions for everyone,<br/>plus questions on each candidate’s own CV"]
    kit -.->|role filled| close["8 · close-round<br/>delete candidate data, keep a pseudonymous audit"]
